      }
    },
    {
      "name": "kiro with tty unavailable",
      "env": {
        "TERM_PROGRAM": "kiro"
      },
      "expected": {
        "agent_id": null,
        "evidence": "none"
      }
    },
    {
      "name": "kiro non-tty is context",
      "env": {
        "TERM_PROGRAM": "kiro"
      },
      "stdout_is_tty": false,
      "expected": {
        "agent_id": "kiro",
        "evidence": "context-hint"
      }
    },
    {
      "name": "kiro human terminal not matched",
      "env": {
        "TERM_PROGRAM": "kiro"
      },
      "stdout_is_tty": true,
      "expected": {
        "agent_id": null,
        "evidence": "none"
