{
  "spec_version": "0.1.0",
  "cases": [
    {
      "name": "empty environment",
      "env": {},
      "expected": {
        "agent_id": null,
        "evidence": "none"
      }
    },
    {
      "name": "known declaration wins inherited marker",
      "env": {
        "AI_AGENT": " codex_cli ",
        "CURSOR_AGENT": "1"
      },
      "expected": {
        "agent_id": "codex",
        "evidence": "declared"
      }
    },
    {
      "name": "first unknown declaration blocks fallback",
      "env": {
        "AI_AGENT": "unregistered-example",
        "AGENT": "manus",
        "CURSOR_AGENT": "1"
      },
      "expected": {
        "agent_id": null,
        "evidence": "declared"
      }
    },
    {
      "name": "empty first declaration uses second",
      "env": {
        "AI_AGENT": " ",
        "AGENT": "MANUS"
      },
      "expected": {
        "agent_id": "manus",
        "evidence": "declared"
      }
    },
    {
      "name": "declaration-only product",
      "env": {
        "AGENT": "hi"
      },
      "expected": {
        "agent_id": "hi",
        "evidence": "declared"
      }
    },
    {
      "name": "declaration can identify a context-only product",
      "env": {
        "AGENT": "zed"
      },
      "expected": {
        "agent_id": "zed",
        "evidence": "declared"
      }
    },
    {
      "name": "qwen arbitrary non-empty value",
      "env": {
        "QODER_WORK_INTEGRATION_PRODUCT": "another-name"
      },
      "expected": {
        "agent_id": "qwenwork",
        "evidence": "runtime-marker"
      }
    },
    {
      "name": "qwen whitespace counts",
      "env": {
        "QODER_WORK_INTEGRATION_PRODUCT": " \t "
      },
      "expected": {
        "agent_id": "qwenwork",
        "evidence": "runtime-marker"
      }
    },
    {
      "name": "qwen empty fails",
      "env": {
        "QODER_WORK_INTEGRATION_PRODUCT": ""
      },
      "expected": {
        "agent_id": null,
        "evidence": "none"
      }
    },
    {
      "name": "qwen configuration alone fails",
      "env": {
        "QODERWORK_IS_CN": "true",
        "QODER_SITE": "cn",
        "QODERWORK_EXECUTION_ENV": "local",
        "QWENWORK_BASE_URL": "https://service.example.invalid"
      },
      "expected": {
        "agent_id": null,
        "evidence": "none"
      }
    },
    {
