    },
    {
      "name": "devin file probe unavailable",
      "env": {},
      "expected": {
        "agent_id": null,
        "evidence": "none"
      }
    },
    {
      "name": "devin file probe available",
      "env": {},
      "files": [
        "/opt/.devin"
      ],
      "expected": {
        "agent_id": "devin",
        "evidence": "context-hint"
      }
    },
    {
      "name": "pi path components",
      "env": {
        "PATH": "/tmp/.pi/agent/bin:/usr/bin"
      },
      "path_separator": ":",
      "expected": {
        "agent_id": "pi",
        "evidence": "context-hint"
      }
    },
    {
      "name": "pi similar component fails",
      "env": {
        "PATH": "/tmp/.pi/agents/bin:/usr/bin"
      },
      "path_separator": ":",
      "expected": {
        "agent_id": null,
        "evidence": "none"
      }
    },
    {
      "name": "non-empty false string is not boolean",
      "env": {
        "CRUSH": "false"
      },
      "expected": {
        "agent_id": "crush",
